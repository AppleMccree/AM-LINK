# 例如 classroom.example.com，先把域名 A 记录指向服务器公网 IP。
CLASSROOM_DOMAIN=classroom.example.com

# 至少 32 位随机字符。首次打开教师网页时需要输入一次。
CLASSROOM_BOOTSTRAP_KEY=replace-with-a-long-random-secret

# 可留空；留空时学校统一 AI 不可用，但学生个人千问 Key 和问题板仍可用。
QWEN_API_KEY=
QWEN_ENDPOINT=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions
