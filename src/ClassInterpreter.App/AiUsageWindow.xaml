<Window x:Class="ClassInterpreter.App.AiUsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 用量" Width="760" Height="620" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#0B0C0E" Foreground="#F4F0E6"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">
    <Border BorderBrush="#6A592B" BorderThickness="1" CornerRadius="12" Padding="22">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="AI 用量" Foreground="#D5B85C" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="按新加坡站公开表价估算；未扣免费额度、促销或缓存优惠，实际账单以千问控制台为准。" Foreground="#8D887E" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,18,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Background="#111214" BorderBrush="#4A4027" BorderThickness="1" CornerRadius="9" Padding="14"><StackPanel><TextBlock Text="今日" Foreground="#8D887E"/><TextBlock x:Name="TodayText" Text="正在读取……" FontSize="18" Foreground="#F4E7BC" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Grid.Column="2" Background="#111214" BorderBrush="#4A4027" BorderThickness="1" CornerRadius="9" Padding="14"><StackPanel><TextBlock Text="本月" Foreground="#8D887E"/><TextBlock x:Name="MonthText" Text="正在读取……" FontSize="18" Foreground="#F4E7BC" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Grid.Column="4" Background="#111214" BorderBrush="#4A4027" BorderThickness="1" CornerRadius="9" Padding="14"><StackPanel><TextBlock Text="累计" Foreground="#8D887E"/><TextBlock x:Name="AllText" Text="正在读取……" FontSize="18" Foreground="#F4E7BC" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></Border>
            </Grid>
            <TextBox x:Name="DetailsBox" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     Background="#090A0B" Foreground="#E7E2D7" BorderBrush="#3C3728" BorderThickness="1"
                     Padding="16" FontSize="14"/>
        </Grid>
    </Border>
</Window>
