<Window x:Class="ClassInterpreter.App.ClassroomWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AM-LINK 云端课堂" Width="760" Height="720" MinWidth="650" MinHeight="560" Background="{StaticResource ConsoleBackgroundBrush}" Foreground="{StaticResource PrimaryTextBrush}" WindowStartupLocation="CenterOwner">
 <Border BorderBrush="#5D512E" BorderThickness="1" CornerRadius="12" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="加入云端课堂" Foreground="{StaticResource GoldAccentBrush}" FontSize="23" FontWeight="Bold"/><TextBlock Text="匿名加入；不上传姓名、录音、完整字幕或课件" Foreground="#8D887E" Margin="0,5,0,0"/></StackPanel></Grid>
  <Grid Grid.Row="1" Margin="0,20,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="课堂服务器" Foreground="#989287"/><TextBox x:Name="ServerBox" Style="{StaticResource MacTextBoxStyle}" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="六位课堂码" Foreground="#989287"/><TextBox x:Name="CodeBox" Style="{StaticResource MacTextBoxStyle}" Margin="0,7,0,0" MaxLength="6" FontSize="19" HorizontalContentAlignment="Center"/></StackPanel></Grid>
  <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="150"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="JoinButton" Content="匿名加入课堂" Style="{StaticResource PillButtonStyle}" Height="44" Click="Join_Click"/><Button Grid.Column="2" x:Name="TestServerButton" Content="检测服务器" Style="{StaticResource DashedConsoleButtonStyle}" Height="44" Click="TestServer_Click"/><Button Grid.Column="4" x:Name="ConfusionButton" Content="一键没听懂" Style="{StaticResource DashedConsoleButtonStyle}" Height="44" Click="Confusion_Click" IsEnabled="False"/></Grid>
  <Border Grid.Row="3" Background="#0B0C0E" BorderBrush="#3C3728" BorderThickness="1" CornerRadius="10" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="班级匿名问题板" Foreground="{StaticResource GoldAccentBrush}" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="StatsText" Text="尚未加入" HorizontalAlignment="Right" Foreground="#8D887E"/></Grid><ListBox x:Name="QuestionList" Grid.Row="1" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" Foreground="#E7E2D7"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#413A25" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,5"><StackPanel><TextBlock Text="{Binding Question}" TextWrapping="Wrap" FontSize="15"/><TextBlock Text="{Binding Meta}" Foreground="#817B70" FontSize="10" Margin="0,7,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
  <Grid Grid.Row="4" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="BroadcastText" Text="老师广播：暂无" Foreground="#D5C98C" TextWrapping="Wrap"/><TextBlock x:Name="StatusText" Text="未加入云端课堂；单机同传正常可用" Foreground="#77736B" FontSize="10" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="2" Content="给选中问题点赞" Style="{StaticResource SecondaryPillButtonStyle}" Click="Vote_Click"/></Grid>
 </Grid></Border>
</Window>
