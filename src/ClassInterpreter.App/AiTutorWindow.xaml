<Window x:Class="ClassInterpreter.App.AiTutorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="问 AI" Width="520" Height="430" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="#0B0C0E" Foreground="#F4F0E6"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">
    <Border BorderBrush="#6A592B" BorderThickness="1" CornerRadius="12" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <TextBlock Text="问 AI" Foreground="#D5B85C" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="回答会自动保存到本节课" Foreground="#77736B" FontSize="10" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Visibility="Collapsed">
                <TextBlock x:Name="ContextPreviewText" Foreground="#A49E91" FontSize="10" TextWrapping="Wrap" MaxHeight="50" TextTrimming="CharacterEllipsis"/>
            </Border>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
                <TextBox x:Name="QuestionBox" Style="{StaticResource MacTextBoxStyle}" FontSize="14" ToolTip="输入课堂问题" KeyDown="QuestionBox_KeyDown"/>
                <Button x:Name="AskButton" Grid.Column="2" Content="询问" Style="{StaticResource PillButtonStyle}" Height="40" Click="AskButton_Click"/>
            </Grid>
            <TextBox x:Name="AnswerBox" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     Background="#090A0B" Foreground="#E7E2D7" BorderBrush="#3C3728" BorderThickness="1"
                     FontSize="15" Padding="13" Margin="0,12,0,10" Text="在上方输入问题。"/>
            <Grid Grid.Row="4">
                <TextBlock x:Name="StatusText" Foreground="#8D887E" FontSize="10" VerticalAlignment="Center"/>
                <Button x:Name="RetryButton" Content="重新询问" HorizontalAlignment="Right" Height="32"
                        Style="{StaticResource SecondaryPillButtonStyle}" Click="RetryButton_Click" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</Window>
