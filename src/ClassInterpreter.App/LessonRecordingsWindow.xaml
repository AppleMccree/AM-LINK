<Window x:Class="ClassInterpreter.App.LessonRecordingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="课堂录音" Width="720" Height="480" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="#0B0C0E" Foreground="#F4F0E6"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">
    <Border BorderBrush="#6A592B" BorderThickness="1" CornerRadius="12" Padding="20">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="课堂录音" Foreground="#D5B85C" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="录音按实际开始时间排列；双击即可用系统播放器打开。" Foreground="#8D887E" FontSize="11" Margin="0,5,0,0"/>
            </StackPanel>
            <ListBox x:Name="RecordingList" Grid.Row="1" Margin="0,16,0,14" Background="#090A0B" Foreground="#E7E2D7"
                     BorderBrush="#3C3728" BorderThickness="1" MouseDoubleClick="RecordingList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="10,8">
                            <TextBlock Text="{Binding DisplayName}" FontSize="15" Foreground="#F4E7BC"/>
                            <TextBlock Text="{Binding Path}" FontSize="10" Foreground="#77736B" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button Content="播放所选录音" Height="42" Style="{StaticResource PillButtonStyle}" Click="PlayButton_Click"/>
                <Button Grid.Column="2" Content="打开文件位置" Height="42" Style="{StaticResource SecondaryPillButtonStyle}" Click="OpenLocationButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
